.wish-card{margin-top:22rpx;padding:30rpx;border-radius:28rpx;background:#fff;box-shadow:0 8rpx 28rpx rgba(78,35,52,.07)}.wish-top{display:flex;justify-content:space-between}.reward{color:#9a536d;font-size:24rpx}.wish-place{display:block;margin-top:22rpx;font-size:30rpx;font-weight:700}.wish-message{display:block;margin-top:16rpx;font-size:28rpx;line-height:1.6}.wish-meta{display:block;margin-top:20rpx;color:#80757a;font-size:24rpx}.empty-title{display:block;margin-bottom:14rpx;font-size:32rpx;font-weight:700}.mask{position:fixed;z-index:30;inset:0;padding:90rpx 28rpx;background:rgba(25,23,25,.42);overflow:auto}.sheet{margin-bottom:90rpx;padding:32rpx;border-radius:30rpx;background:#fff}.card-title{display:block;font-size:36rpx;font-weight:700}.notice{display:block;margin-top:26rpx;color:#80757a;font-size:24rpx;line-height:1.65}
