<view class="page"><text class="eyebrow">我的</text><view class="title">{{user ? '你的心意记录' : '从这里开始'}}</view><view wx:if="{{!user}}" class="card"><text class="card-title">用微信保存你的记录</text><text class="muted">浏览无需登录。发布、响应、本人记录和确认完成会使用微信登录建立你的专属账户。</text><button class="primary-button" loading="{{loading}}" bindtap="signIn">登录微信</button></view><view wx:else class="card"><text class="card-title">微信账户已连接</text><text class="muted">仅用于识别你的发布和响应；不会公开你的微信身份。</text><button class="secondary-button" loading="{{deleting}}" bindtap="deleteAccount">删除账户</button></view><view class="card"><text class="card-title">用编号查询</text><text class="muted">兼容历史记录：请输入发布成功后保存的编号和当时填写的联系方式。</text><label class="label">心愿编号</label><input class="input" data-key="code" value="{{code}}" bindinput="input" placeholder="例如 HW260719-ABCDE"/><label class="label">联系方式</label><input class="input" data-key="contact" value="{{contact}}" bindinput="input"/><button class="primary-button" loading="{{tracking}}" bindtap="track">查询进度</button><view wx:if="{{tracked}}" class="tracked"><text class="status">{{tracked.statusLabel}}</text><text class="tracked-title">{{tracked.city}} · {{tracked.landmark}}</text><text class="muted">{{tracked.message}}</text></view></view><view wx:if="{{user && activity}}" class="activity"><text class="section-title">我发布的</text><view wx:if="{{activity.requests.length}}" wx:for="{{activity.requests}}" wx:key="id" class="record"><text class="status">{{item.statusLabel}}</text><text class="record-title">{{item.city}} · {{item.landmark}}</text><text class="muted">{{item.publicCode}}</text><button wx:if="{{item.hasDeliverable}}" class="link-button" data-id="{{item.id}}" bindtap="openDelivery">查看交付</button><button wx:if="{{item.canConfirmCompletion}}" class="link-button" data-id="{{item.id}}" bindtap="complete">确认完成</button></view><view wx:else class="card muted">还没有发布记录。</view><text class="section-title">我响应的</text><view wx:if="{{activity.responses.length}}" wx:for="{{activity.responses}}" wx:key="wish.id" class="record"><text class="status">{{item.statusLabel}}</text><text class="record-title">{{item.wish.city}} · {{item.wish.landmark}}</text><text class="muted">响应状态：{{item.responseStatus}}</text></view><view wx:else class="card muted">还没有响应记录。</view></view><text wx:if="{{error}}" class="error">{{error}}</text></view><bottom-nav active="profile" />
