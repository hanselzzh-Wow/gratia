.nav-title{font-size:36rpx;font-weight:700}.search-row{display:flex;align-items:center;gap:14rpx;box-sizing:border-box;width:100%;margin-top:26rpx;padding:0 24rpx;min-height:88rpx;border-radius:20rpx;background:#faf4f6}.search-row image{width:34rpx;height:34rpx}.search-row input{flex:1;font-size:28rpx}.search-row text{font-size:44rpx;color:#6d666a}.filters{white-space:nowrap;margin-top:22rpx}.filter,.clear{display:inline-block;margin-right:14rpx;padding:0 26rpx;min-height:66rpx;line-height:66rpx;border:1rpx solid #ecd9e1;border-radius:33rpx;background:#fff;color:#191719;font-size:24rpx}.filter.selected{background:#faf4f6;color:#7f4058}.clear{color:#9a536d;border:0}.search-empty{display:flex;flex-direction:column;align-items:center;padding:210rpx 36rpx 0;text-align:center}.search-empty image{width:72rpx;height:72rpx;opacity:.45}.empty-title{display:block;margin-top:30rpx;font-size:34rpx;font-weight:700}.empty-copy{display:block;margin-top:16rpx;color:#6d666a;font-size:26rpx;line-height:1.7}
