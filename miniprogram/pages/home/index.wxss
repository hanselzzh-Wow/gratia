.topbar{display:flex;align-items:center;justify-content:space-between}.brand{font-size:36rpx;font-weight:700}.wish-pill{min-width:100rpx;min-height:64rpx;line-height:64rpx;padding:0 22rpx;border-radius:32rpx;background:#fff;color:#9a536d;border:1rpx solid #e4c6d0;font-size:24rpx}.empty-wrap{display:flex;flex-direction:column;align-items:center;padding:160rpx 28rpx 0;text-align:center}.story-mark{display:grid;width:160rpx;height:160rpx;place-items:center;border:1rpx solid #e4c6d0;border-radius:80rpx;background:#faf4f6}.story-mark image{width:72rpx;height:72rpx}.empty-title{display:block;margin-top:36rpx;font-size:38rpx;font-weight:700}.empty-copy{display:block;margin-top:18rpx;color:#6d666a;font-size:27rpx;line-height:1.7}.empty-wrap .primary-button{width:100%;margin-top:42rpx}.text-button{margin-top:20rpx;background:transparent;color:#9a536d;font-size:27rpx;line-height:64rpx}.text-button::after{border:0}
