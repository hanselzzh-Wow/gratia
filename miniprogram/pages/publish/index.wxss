.steps{display:flex;gap:10rpx;margin-top:30rpx}.step{flex:1;height:8rpx;border-radius:4rpx;background:#e4c6d0}.step.on{background:#9a536d}.card-title{display:block;font-size:36rpx;font-weight:700}.radio-group{}.notice{display:block;margin-top:26rpx;color:#80757a;font-size:24rpx;line-height:1.65}.consent{display:block;margin-top:28rpx;font-size:25rpx;line-height:1.5}.success{text-align:center}.success-mark{display:grid;width:84rpx;height:84rpx;place-items:center;margin:0 auto 24rpx;border-radius:42rpx;background:#f2e5e9}.success-mark image{width:44rpx;height:44rpx}.code{display:block;margin-top:24rpx;color:#7f4058;font-size:30rpx;font-weight:700;letter-spacing:1rpx}
