<view class="page"><text class="eyebrow">发布心愿</text><view wx:if="{{step < 4}}" class="title">第 {{step}} 步，共 3 步</view><view wx:if="{{step < 4}}" class="steps"><view class="step {{step >= 1 ? 'on' : ''}}"></view><view class="step {{step >= 2 ? 'on' : ''}}"></view><view class="step {{step >= 3 ? 'on' : ''}}"></view></view>
<view wx:if="{{step === 1}}" class="card"><text class="card-title">你想去哪里？</text><label class="label">城市</label><input class="input" data-key="city" value="{{form.city}}" bindinput="input" placeholder="例如：上海"/><label class="label">地标</label><input class="input" data-key="landmark" value="{{form.landmark}}" bindinput="input" placeholder="例如：外滩"/><button class="primary-button" bindtap="next">继续</button></view>
<view wx:elif="{{step === 2}}" class="card"><text class="card-title">把心意说清楚</text><label class="label">心愿场景</label><input class="input" data-key="occasion" value="{{form.occasion}}" bindinput="input" placeholder="例如：生日祝福"/><label class="label">想说的话</label><textarea class="textarea" data-key="message" value="{{form.message}}" bindinput="input" placeholder="至少 5 个字" maxlength="120"/><label class="label">交付方式</label><radio-group bindchange="chooseType"><label><radio value="spoken_video" checked="{{form.deliveryType === 'spoken_video'}}" color="#9A536D"/>口播视频</label><label><radio value="scenery_voiceover" checked="{{form.deliveryType === 'scenery_voiceover'}}" color="#9A536D"/>景色配音</label><label><radio value="handwritten_card" checked="{{form.deliveryType === 'handwritten_card'}}" color="#9A536D"/>手写卡片</label></radio-group><button class="secondary-button" bindtap="prev">上一步</button><button class="primary-button" bindtap="next">继续</button></view>
<view wx:elif="{{step === 3}}" class="card"><text class="card-title">确认并提交</text><label class="label">称呼</label><input class="input" data-key="requesterName" value="{{form.requesterName}}" bindinput="input" placeholder="仅运营与履约联系使用"/><label class="label">联系方式</label><input class="input" data-key="contact" value="{{form.contact}}" bindinput="input" placeholder="仅运营与履约联系使用"/><label class="label">期望时间</label><input class="input" data-key="deadlineText" value="{{form.deadlineText}}" bindinput="input" placeholder="例如：本周内"/><label class="label">感谢金（元，可填 0）</label><input class="input" type="digit" data-key="rewardFen" value="{{form.rewardFen}}" bindinput="input" placeholder="例如：18"/><checkbox-group bindchange="consent"><label class="consent"><checkbox value="contact" checked="{{form.contactConsent}}" color="#9A536D"/>我同意运营人员为审核和履约联系我</label></checkbox-group><text class="notice">提交后进入人工审核；审核通过后会出现在帮助页供他人响应。最后一步将调用微信登录，取消登录不会发送心愿。</text><button class="secondary-button" bindtap="prev">上一步</button><button class="primary-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">登录微信并提交</button></view>
<view wx:else class="card success"><view class="success-mark"><image src="/assets/lucide/check.svg" mode="aspectFit"/></view><text class="card-title">已提交，等待人工审核</text><text class="muted">审核通过后会出现在帮助页。你可在“我的”查看编号、进度和交付。</text><text class="code">{{success.publicCode}}</text><button class="primary-button" bindtap="reset">再发布一个心愿</button></view><text wx:if="{{error}}" class="error">{{error}}</text></view><bottom-nav active="publish" />
